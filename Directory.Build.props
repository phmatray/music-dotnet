<Project>

  <PropertyGroup>
    <!-- Default TFM for every project in the repo. Projects that ship on NuGet
         override this with <TargetFrameworks> (see MusicTheory.csproj).
         net9.0 is out of support since 2026-05-12 and must not be reintroduced. -->
    <TargetFramework>net10.0</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Common Package Metadata -->
    <Authors>phmatray</Authors>
    <Company>phmatray</Company>
    <Copyright>Copyright © 2026 phmatray</Copyright>
    <PackageProjectUrl>https://github.com/phmatray/music-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/phmatray/music-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- SourceLink and Deterministic Build -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- SourceLink for all packable projects -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

</Project>
