<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- xunit.v3 under Microsoft.Testing.Platform, matching the other suites.
             TFM/Nullable/ImplicitUsings come from the repo-root Directory.Build.props. -->
        <OutputType>Exe</OutputType>
        <RootNamespace>WebAudioInterop.UnitTests</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <TestingPlatformCaptureOutput>true</TestingPlatformCaptureOutput>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="bunit" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\WebAudioInterop\WebAudioInterop.csproj" />
    </ItemGroup>

</Project>
