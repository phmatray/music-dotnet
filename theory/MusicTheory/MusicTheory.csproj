<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Lib publiee sur NuGet (2 327 telechargements) : net8.0 (LTS jusqu'au 10/11/2026) + net10.0.
         net9.0 retire, hors support depuis le 12/05/2026.
         TargetFramework doit etre vide : herite de Directory.Build.props, non vide il ferait
         ignorer TargetFrameworks par le SDK. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

    <!-- Package Information -->
    <PackageId>MusicTheory</PackageId>
    <Version>1.0.0</Version>
    <Product>MusicTheory</Product>
    <Description>A comprehensive .NET library for music theory operations including notes, intervals, scales, chords, and chord progressions. Provides immutable domain objects with calculated properties for frequency, semitones, and musical relationships.</Description>
    <PackageTags>music;theory;notes;scales;chords;intervals;music-theory;dotnet;csharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>Initial release with core music theory concepts: Note, Interval, Scale, Chord, TimeSignature, and Duration.</PackageReleaseNotes>

    <!-- Build Configuration -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
